{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voz-traductor",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/_api/*"]
  },
  "observability": {
    "enabled": true
  }
}
